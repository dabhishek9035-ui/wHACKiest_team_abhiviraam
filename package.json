{
  "name": "pengu",
  "version": "0.1.0",
  "private": true,
  "description": "Pengu — persistent, customizable AI desktop companion connecting everyday apps through MCP (wHACKiest 2026, Track 1).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:agent": "pnpm --filter @pengu/agent dev",
    "test:agent": "pnpm --filter @pengu/agent test",
    "smoke:glm": "pnpm --filter @pengu/agent smoke:glm"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
