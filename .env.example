# Pengu environment variables — NAMES ONLY.
# Copy to .env, fill real values locally. Never commit values. Never log them.

# Sarvam Token Factory key (GLM model access, Saaras STT, Bulbul TTS)
SARVAM_API_KEY=

# HMAC secret for exact-action approval tokens (M1 signs; M3/M4 servers verify)
PENGU_APPROVAL_SECRET=

# Google OAuth desktop client for Gmail MCP (M3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-launch WebSocket auth token for the agent (M1 issues, M2 UI presents)
PENGU_WS_TOKEN=

# Log level: error | warn | info | debug
PENGU_LOG_LEVEL=info

# Optional: override the mcp/local config directory (defaults to mcp/local/config)
PENGU_LOCAL_MCP_CONFIG=
