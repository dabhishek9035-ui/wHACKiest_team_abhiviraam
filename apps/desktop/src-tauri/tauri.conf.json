{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pengu",
  "version": "0.1.0",
  "identifier": "com.abhiviraam.pengu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Pengu",
        "width": 220,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420 ws://127.0.0.1:7777 http://127.0.0.1:7777"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
